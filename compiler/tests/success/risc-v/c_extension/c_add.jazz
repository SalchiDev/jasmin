export
fn c_add(reg u32 arg0, reg u32 arg1) -> reg u32 {
    reg u32 x;

    // Registers.
    arg0 = arg0 + arg1;
    arg0 += arg1;
    x = arg0;
    [x] = x;

    // Immediates.
    arg0 += -32;
    arg0 -= 31;
    arg0 = arg0 - 30;
    arg0 = arg0 + 31;
    x = arg0;
    [x] = x;

    reg u32 res;
    res = x;
    return res;
}
