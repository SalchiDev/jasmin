export
fn c_li() -> reg u32 {
    reg u32 x;

    // Immediates.
    x = #C_LI(-32);
    [x] = x;
    x = #C_LI(31);
    [x] = x;
    x = #C_LI(0);
    [x] = x;

    x = #C_LUI(1);
    [x] = x;
    x = #C_LUI(31);
    [x] = x;
    x = #C_LUI(1048544);
    [x] = x;
    x = #C_LUI(1048575);
    [x] = x;

    reg u32 res;
    res = x;
    return res;
}
