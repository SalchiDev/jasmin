export
fn c_li() -> reg u32 {
    reg u32 x;

    // Immediates.
    x = -32;
    [x] = x;
    x = 0;
    [x] = x;
    x = 31;
    [x] = x;

    x = 4096;
    [x] = x;
    x = 126976;
    [x] = x;
    x = 4294963200;
    [x] = x;
    x = 4294836224;
    [x] = x;

    reg u32 res;
    res = x;
    return res;
}
