export
fn xor(reg u32 arg0, reg u32 arg1) -> reg u32 {
    reg u32 x;

    // Registers.
    x = #XOR(arg0, arg1);
    [x] = x;

    // Immediates.
    x = #XORI(arg0, 1);
    [x] = x;
    x = #XORI(arg0, -1);
    [x] = x;
    x = #XORI(arg0, -1);
    x = #XORI(x, -2048);
    x = #XORI(x, 0);
    x = #XORI(x, 2047);
    [x] = x;

    reg u32 res;
    res = x;
    return res;
}
