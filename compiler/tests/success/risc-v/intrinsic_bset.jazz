export
fn bset(reg u32 arg0, reg u32 arg1) -> reg u32 {
    reg u32 x;

    // Registers.
    x = #BSET(arg0, arg1);
    [x] = x;

    // Immediates.
    x = #BSETI(arg0, 0);
    [x] = x;
    x = #BSETI(arg0, 1);
    [x] = x;
    x = #BSETI(arg0, 31);
    [x] = x;

    reg u32 res;
    res = x;
    return res;
}